{
  "mcpServers": {
    "mcp-ntp": {
      "command": "uv",
      "args": [
        "--directory",
        "path_to_your_local_mcp-project",
        "run",
        "mcp-ntp"
      ],
      "env": {
        "NTP_DOMAIN_URL": "pool.ntp.org"
      }
    },
    "mcp-ntp-uvx": {
      "command": "uvx",
      "args": ["mcp-ntp"],
      "env": {
        "NTP_DOMAIN_URL": "pool.ntp.org"
      }
    }
  }
}
